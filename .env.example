# ============================================================================
# .env.example — frontend Next.js (copiar a .env.local)
# NUNCA versionar .env.local ni usar estos valores en produccion.
#
# NextAuth v5: AUTH_SECRET y NEXTAUTH_SECRET deben coincidir.
# Genera uno con: openssl rand -base64 32
# ============================================================================

# URL del backend FastAPI. Se usa solo en el servidor (BFF); no se expone al
# navegador porque no lleva el prefijo NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8000

# --- NextAuth / sesion -------------------------------------------------------
AUTH_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
NEXTAUTH_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Google OAuth ------------------------------------------------------------
# Mismo Client ID que GOOGLE_CLIENT_ID del backend.
# Redirect URI autorizado en Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=reemplazar.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=reemplazar

# --- Validacion del formulario de usuarios ----------------------------------
# Dominio institucional permitido (sin @). Vacio = cualquier dominio.
# Se incrusta en el bundle: requiere rebuild si cambia en produccion.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=uc.edu.ve
